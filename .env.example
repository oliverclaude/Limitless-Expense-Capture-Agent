# Copy to a root-owned file on the LXC (for example /etc/expense-agent/env).
# Leave these empty in git. Fill values only on the LXC.
# Run with: ENV_FILE=/etc/expense-agent/env python3 agent.py

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Work address for Done/Skipped only. Never inferred from mail headers.
WORK_EMAIL=
# SMTP defaults to IMAP host/user/password. Port 465 SMTPS if empty.
SMTP_HOST=
SMTP_PORT=

# Local Expenses mount. If empty, the agent uses /g-drive.
EXPENSES_ROOT=

# xAI — live values only on the LXC, never in git.
XAI_API_KEY=
XAI_MODEL=
# Comma-separated journals the model may pick from.
JOURNALS=Entertainment
# Journals that may claim VAT. All others get vat 0 (e.g. Entertainment in SA).
VAT_JOURNALS=
# Optional. Remaining prepaid balance (management API).
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=
# Fallback leftover tracker if no management key: starting prepaid USD.
# After you top up, set this to the NEW remaining balance and delete
# prepaid.json next to ENV_FILE (usually /etc/expense-agent/prepaid.json).
XAI_PREPAID_USD=
# ntfy on the main topic when remaining prepaid USD is at or below this.
XAI_CREDIT_ALERT_USD=0.05
# Hours between repeated credit-low pings.
XAI_CREDIT_ALERT_COOLDOWN_HOURS=6

# ntfy (LAN). Live host only on the LXC, never in git.
NTFY_URL=
NTFY_TOPIC=
# Pending ntfy claims. Default in code is /g-drive/agent-state if empty.
AGENT_STATE_DIR=
# Delete logged/skipped state after Done is sent. 1=yes, 0=keep until retention.
DELETE_COMPLETED_STATE=1
# Delete remaining state files this many days after last update.
STATE_RETENTION_DAYS=60

# Git checkout on the LXC (systemd service).
AGENT_HOME=
# Minutes between runs when started with --loop. Default 30.
POLL_INTERVAL_MINUTES=30
