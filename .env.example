# Copy to a root-owned file on the LXC (for example /etc/expense-agent/env).
# Leave these empty in git. Fill values only on the LXC.
# Run with: ENV_FILE=/etc/expense-agent/env python3 agent.py

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Local Expenses mount. If empty, the agent uses /g-drive.
EXPENSES_ROOT=

# xAI — live values only on the LXC, never in git.
XAI_API_KEY=
XAI_MODEL=
# Comma-separated journals the model may pick from.
JOURNALS=Entertainment
# Optional. Remaining prepaid balance (management API).
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=
# Fallback leftover tracker if no management key: starting prepaid USD.
XAI_PREPAID_USD=
